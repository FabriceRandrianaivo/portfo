# Modèle de configuration — copie ce fichier en ".env.local" et remplis les valeurs.
# Source des valeurs : Supabase → Project Settings → API

# URL du projet Supabase (ex. https://abcdxyz.supabase.co)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé publique "anon" (safe côté client, protégée par les règles RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# (Optionnel) Notification email des messages de contact via Web3Forms.
# Récupère une clé gratuite sur https://web3forms.com (juste ton email, sans compte).
# Sans cette clé, les messages sont quand même enregistrés dans Supabase (onglet Messages du back office).
VITE_WEB3FORMS_KEY=
